{
  "name": "restaurant_app_desktop_version",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "^57.0.7",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/stack": "^7.10.17",
    "axios": "^1.18.1",
    "electron-serve": "^3.0.1",
    "expo": "~57.0.8",
    "expo-av": "^16.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.26.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "electron:start": "electron electron/main.js",
    "build:win": "expo export -p web && electron-builder --win"
  },
  "private": true,
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.restaurant.desktop",
    "productName": "Data Udipi Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis"
    }
  }
}
